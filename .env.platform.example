# ============================================================================
# CLARITY PLATFORM - SYSTEM CONFIGURATION (Platform-Managed)
# ============================================================================
# ⚠️  WARNING: This file is automatically managed by Clarity Platform.
# ⚠️  DO NOT EDIT MANUALLY - Changes will be overwritten automatically.
#
# This file contains infrastructure and security settings that are managed
# by the Clarity Platform. These settings are NOT configurable by users.
#
# Last updated: [Automatically set by platform]
# Managed by: Clarity Platform v2.0
# ============================================================================

# ============================================================================
# INFRASTRUCTURE
# ============================================================================

# Container Naming (for multi-app deployments)
CONTAINER_PREFIX=[app-name]  # Platform generates unique prefix per app

# Database (PostgreSQL) - Automatically provisioned
POSTGRES_USER=generated_user  # Auto-generated database user
POSTGRES_PASSWORD=generated_pass  # Auto-generated strong password
POSTGRES_DB=app_[app-id]  # Unique database per app
DATABASE_URL=postgresql://generated_user:generated_pass@postgres:5432/app_[app-id]

# Port Configuration - Dynamically assigned to avoid conflicts
POSTGRES_PORT=5432  # Platform assigns unique port per app
BACKEND_PORT=8000  # External port for backend API (auto-assigned)
BACKEND_INTERNAL_PORT=8000  # Internal container port (do not change)
FRONTEND_PORT=3200  # External port for frontend (auto-assigned)

# Redis (Optional) - For caching and distributed triggers
REDIS_URL=redis://clarity-redis-host:6379/[app-number]

# Server Configuration
HOST=0.0.0.0  # Listen on all interfaces

# ============================================================================
# PLATFORM INTEGRATION
# ============================================================================

# Unique app identifier in Clarity Platform
CLARITY_APP_ID=[generated-uuid]

# Clarity Platform URL
CLARITY_PLATFORM_URL=https://platform.clarity.ai

# Webhook validation secret (for platform callbacks)
CLARITY_WEBHOOK_SECRET=[auto-generated-secret]

# ============================================================================
# AI PROVIDER (proxy-based — no provider keys in the app)
# ============================================================================
# The app never holds a provider API key. The platform injects the LLM proxy
# credentials below; the SDK's get_llm_client() uses them to reach Claude
# (metered + BYOK-aware). See claritty_sdk.llm.
CLARITTY_AUTH_TOKEN=[auto-generated-per-app-token]
# MUST be the API host — the SDK appends /api/v1/chat/completions (a clarity-api
# route). The frontend (app.claritty.ai / :3000) has no such route and returns an
# HTML 500. Use api.claritty.ai in prod, http://localhost:4000 against local API.
CLARITTY_PLATFORM_URL=https://api.claritty.ai

# Default AI Model
AI_MODEL=claude-3-5-sonnet-20241022

# AI API Timeouts
AI_TIMEOUT_SECONDS=60

# AI Generation Limits
AI_MAX_TOKENS=4096
AI_TEMPERATURE=1.0

# ============================================================================
# SECURITY & AUTHENTICATION
# ============================================================================

# JWT Token Signing Secret (auto-generated, 64 chars minimum)
JWT_SECRET=[auto-generated-jwt-secret-64-characters-minimum-for-security]

# Session Cookie Secret (auto-generated, 64 chars minimum)
SESSION_SECRET=[auto-generated-session-secret-64-characters-minimum]

# ============================================================================
# CORS CONFIGURATION
# ============================================================================

# Frontend URL (for backend CORS configuration)
FRONTEND_URL=http://localhost:${FRONTEND_PORT}  # Updated dynamically based on deployment

# API URL (for frontend to call backend)
VITE_API_URL=http://localhost:${BACKEND_PORT}  # Updated dynamically based on deployment

# Allowed CORS Origins (comma-separated)
# In production: https://[app-name].clarity.app,https://platform.clarity.ai
CORS_ALLOWED_ORIGINS=http://localhost:${FRONTEND_PORT},http://localhost:3000

# ============================================================================
# MONITORING & LOGGING
# ============================================================================

# Logging Configuration
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FORMAT=json  # json or text

# Error Tracking (Sentry)
SENTRY_DSN=https://[platform-provided-sentry-dsn]@sentry.clarity.ai/[project-id]
SENTRY_ENVIRONMENT=production  # production, staging, development
SENTRY_TRACES_SAMPLE_RATE=0.1

# Metrics (Prometheus)
METRICS_ENABLED=true
METRICS_PORT=9090

# Health Checks
HEALTH_CHECK_ENABLED=true

# ============================================================================
# RESOURCE LIMITS (Platform-Enforced)
# ============================================================================

# Workflow Execution Limits
WORKFLOW_MAX_CONCURRENT=5  # Maximum concurrent workflows
WORKFLOW_EXECUTION_TIMEOUT_SECONDS=300  # 5 minutes maximum per workflow

# Trigger Limits
TRIGGER_MAX_PER_USER=10  # Maximum trigger instances per user

# Database Connection Pool
DATABASE_POOL_SIZE=20  # Maximum database connections
DATABASE_MAX_OVERFLOW=10  # Additional overflow connections
DATABASE_POOL_TIMEOUT=30  # Seconds to wait for connection
DATABASE_POOL_RECYCLE=3600  # Recycle connections after 1 hour

# ============================================================================
# COST MANAGEMENT (Platform-Enforced)
# ============================================================================

# AI Token Budgets
AI_DAILY_TOKEN_BUDGET=1000000  # 1M tokens per day
AI_MONTHLY_TOKEN_BUDGET=30000000  # 30M tokens per month

# Usage Tracking
AI_TRACK_USAGE=true  # Track token usage per user/workflow
AI_USAGE_LOG_ENABLED=true  # Log all AI API calls

# Cost Alerts
AI_COST_ALERT_THRESHOLD=100.00  # Alert when daily cost exceeds (USD)
AI_COST_ALERT_EMAIL=[admin-email]

# ============================================================================
# PLATFORM FEATURES
# ============================================================================

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# API Keys
ENABLE_API_KEY_AUTH=false
API_KEY_HEADER=X-API-Key

# Session Management
SESSION_COOKIE_SECURE=true  # HTTPS only in production
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=lax

# ============================================================================
# DEPLOYMENT METADATA (Read-Only)
# ============================================================================

# Deployment Information
DEPLOYMENT_ID=[deployment-uuid]
DEPLOYMENT_TIMESTAMP=[iso-8601-timestamp]
DEPLOYMENT_VERSION=[app-version]

# Container Information
CONTAINER_ID=[docker-container-id]
CONTAINER_MEMORY_LIMIT=2048  # MB
CONTAINER_CPU_LIMIT=2  # CPU cores

# Network Configuration
INTERNAL_NETWORK=clarity-apps-network
DNS_RESOLVER=clarity-dns

# ============================================================================
# PLATFORM WEBHOOKS & CALLBACKS
# ============================================================================

# Platform will call these endpoints on events
WEBHOOK_APP_START=https://platform.clarity.ai/webhooks/app-start
WEBHOOK_APP_STOP=https://platform.clarity.ai/webhooks/app-stop
WEBHOOK_APP_ERROR=https://platform.clarity.ai/webhooks/app-error
WEBHOOK_USAGE_UPDATE=https://platform.clarity.ai/webhooks/usage-update

# ============================================================================
# NOTES FOR PLATFORM ADMINISTRATORS
# ============================================================================
#
# File Management:
# ----------------
# - This file is automatically generated on app deployment
# - Updated automatically when platform settings change
# - Backed up before each update
# - Version controlled in platform internal repository
#
# Security:
# ---------
# - All secrets are auto-generated with cryptographically secure random values
# - Secrets are rotated every 90 days automatically
# - File permissions: 600 (read/write owner only)
# - Never commit this file to version control
# - Encrypted at rest in platform storage
#
# When to Regenerate:
# -------------------
# - App first deployment
# - Security secret rotation (scheduled every 90 days)
# - Resource limit changes
# - Platform migration/scaling events
# - Manual regeneration requested by admin
#
# Configuration Priority:
# -----------------------
# .env.platform (this file) > .env (user config)
# Platform settings ALWAYS override user settings for security and stability
#
# Monitoring:
# -----------
# - Platform monitors all apps using these settings
# - Alerts sent to platform admins on threshold violations
# - Usage metrics aggregated in platform analytics
#
# ============================================================================
