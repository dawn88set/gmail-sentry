# ============================================================================
# CLARITY AGENTIC APP - ENVIRONMENT CONFIGURATION
# ============================================================================
# Quick Start: cp .env.example .env  →  docker compose up
#
# NO API keys needed. AI access goes through the Claritty platform LLM proxy,
# authenticated by CLARITTY_AUTH_TOKEN + CLARITTY_PLATFORM_URL which the platform
# injects automatically when your app is deployed. Running locally with these
# unset, the SDK calls each agent's fallback(ctx) (a deterministic no-AI result),
# so the app works with zero configuration.
# ============================================================================

# ============================================================================
# OPTIONAL: Connect the LOCAL app to the PROD Claritty/AWS services
# ============================================================================
# Leave these empty for a fully local run (local Postgres + agent fallback(ctx), no AI).
# Set them to run the local container against production:
#
#   # Real AI: the published SDK routes Claude through the prod LLM proxy.
#   # This MUST be the API host — the SDK appends /api/v1/chat/completions (a
#   # clarity-api route). The web app (app.claritty.ai / :3000) has no such route
#   # and returns an HTML 500. Use api.claritty.ai in prod, localhost:4000 local.
#   CLARITTY_PLATFORM_URL=https://api.claritty.ai
#   CLARITTY_AUTH_TOKEN=<your per-app token from the platform>
#   # (or set CLARITTY_LLM_PROXY_URL=<proxy base> directly)
#
#   # Prod database (e.g. via the RDS tunnel/bastion) instead of local Postgres:
#   DATABASE_URL=postgresql://USER:PASS@127.0.0.1:5434/DBNAME

# ============================================================================
# OPTIONAL: Development Settings (Auto-configured with smart defaults)
# ============================================================================

# Database (Auto-configured by Docker Compose - no need to change)
# DATABASE_URL=postgresql://clarity_user:clarity_password@localhost:5432/clarity_agentic_app

# Server Ports (Auto-configured - no need to change)
# BACKEND_PORT=8000
# FRONTEND_PORT=3200
# POSTGRES_PORT=5432

# CORS (Auto-configured - no need to change)
# FRONTEND_URL=http://localhost:3200

# Logging (Auto-configured - no need to change)
# LOG_LEVEL=INFO
# DEBUG=false

# Seed fabricated starter rules + sample alerts on boot, so the dashboard and
# the three widget sizes show varied content before Gmail is connected.
# LOCAL DEV AND MARKETPLACE SCREENSHOTS ONLY — leave this unset in production,
# or the app writes placeholder rows into a real database. docker-compose sets
# it to 1 for you; nothing else does.
# SEED_DEMO_DATA=1

# ============================================================================
# OPTIONAL: App-Specific Settings (From app-config.json)
# ============================================================================
# These settings can be configured through the Clarity Platform UI
# For local development, uncomment and modify as needed
#
# App-specific SECRETS (e.g. an integration token your app reads with os.getenv):
# add them here — docker-compose loads this whole file into the backend (env_file),
# so they reach the container locally. In production the platform injects secrets;
# don't commit real tokens. Most integrations should instead be connected in-app
# and stored per-user (see INTEGRATIONS.md). Advanced encrypted layer uses
# APP_ENCRYPTION_KEY (see INTEGRATIONS.md → Advanced).

# AI Operation Mode (fast, balanced, quality)
# AI_OPERATION_MODE=balanced

# AI Creativity Level (0-100)
# AI_RESPONSE_TEMPERATURE=70

# Workflow Retry Settings
# WORKFLOW_RETRY_FAILED=true
# WORKFLOW_MAX_RETRIES=2
# WORKFLOW_PARALLEL_LIMIT=3

# Notifications
# NOTIFY_ON_WORKFLOW_COMPLETE=true
# NOTIFY_ON_WORKFLOW_FAILURE=true
# NOTIFICATION_EMAIL=

# Slack Integration (Optional)
# ENABLE_SLACK_INTEGRATION=false
# SLACK_WEBHOOK_URL=

# Debug Mode
# DEBUG_MODE=false

# ============================================================================
# NOTES
# ============================================================================
#
# 🚀 Quick Start (60 seconds):
# ------------------------------
# 1. Copy this file: cp .env.example .env
# 2. Run: ./start.sh (or docker compose up)  — no API keys to add
# 3. Done! Your app is running at http://localhost:3200
#
# 📖 What's Auto-Configured:
# --------------------------
# - Database connection (PostgreSQL via Docker)
# - Ports (8000 for backend, 3200 for frontend, 5432 for PostgreSQL)
# - CORS settings
# - Logging configuration
# - Health checks
# - All infrastructure settings
#
# 🎯 For Production Deployment:
# ------------------------------
# When deploying to Clarity Marketplace, the platform automatically manages:
# - Database provisioning and credentials
# - Port allocation and load balancing
# - Security secrets (JWT, session keys)
# - Monitoring and logging configuration
# - Resource limits and cost management
#
# You don't need to configure any of those - the platform handles it!
#
# ============================================================================

# ----------------------------------------------------------------------------
# Gmail Sentry install-time defaults (app-config.json#configSchema)
# ----------------------------------------------------------------------------
# These seed a NEW user's settings row only. Once a user exists, the in-app
# Rules screen owns these values and changing the env never overwrites them.
#
# Which mail is worth interrupting for: urgent | needs_reply
# SENTRY_NOTIFY_TIER=urgent
#
# Pre-draft a reply in the user's voice when mail is flagged, so the
# notification carries a ready-to-send draft. Never sends without approval.
# SENTRY_AUTO_DRAFT=true
#
# Propose a folder for each new conversation, based on who it's with. Folders
# are always proposed for approval first — nothing is created in the mailbox
# without an explicit yes, and filing never removes mail from the inbox.
# SENTRY_FILING_ENABLED=false
