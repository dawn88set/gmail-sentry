{
  "id": "gmail",
  "kind": "integration",
  "category": "email",
  "transport": "native",
  "version": "1.0.0",
  "name": "Gmail",
  "vendor": "Google",
  "description": "Send and read email through the authenticated user's Gmail account.",
  "intentHints": [
    "send an email",
    "search my inbox",
    "reply to a thread",
    "label messages"
  ],
  "authType": "oauth2",
  "_authNote": "OAuth endpoints, scopes, client secret ref and any identity step are PLATFORM-OWNED \u2014 they live in the private clarity-api (integrations-v2/config/oauth-configs.ts), never in this public repo. This manifest only declares that the integration uses oauth2 and which tools it provides.",
  "providedTools": [
    {
      "id": "gmail.send",
      "description": "Send an email.",
      "input": {
        "to": {
          "type": "string",
          "required": true
        },
        "subject": {
          "type": "string",
          "required": true
        },
        "body": {
          "type": "string",
          "required": true
        }
      },
      "output": {
        "message_id": {
          "type": "string",
          "required": true
        }
      }
    },
    {
      "id": "gmail.list_messages",
      "description": "List recent messages.",
      "input": {
        "limit": {
          "type": "integer",
          "required": false
        }
      },
      "output": {
        "messages": {
          "type": "array",
          "required": true
        }
      }
    },
    {
      "id": "gmail.search",
      "description": "Search messages by query (Gmail syntax).",
      "input": {
        "query": {
          "type": "string",
          "required": true
        }
      },
      "output": {
        "messages": {
          "type": "array",
          "required": true
        }
      }
    },
    {
      "id": "gmail.add_label",
      "description": "Add a label to a message.",
      "input": {
        "message_id": {
          "type": "string",
          "required": true
        },
        "label": {
          "type": "string",
          "required": true
        }
      },
      "output": {
        "ok": {
          "type": "boolean",
          "required": true
        }
      }
    }
  ]
}
